# ================================================================
# VIDEO API INTEGRATION — 環境變數設定範例
# EduMath AI — Video API 設定
# ================================================================
#
# 使用說明：
#   1. 複製此檔案為 .env（不要將 .env 加入 Git）
#   2. 填入正式 API 資訊
#   3. 在 services/videoApi.js 的 VideoApiConfig 讀取這些值
#
# 注意：
#   - 不要把真實的 API Key 寫入此範例檔
#   - 前端無法真正保護 Secret Key
#   - 如果 API 需要 Secret，請透過後端 Proxy 轉發
#
# 後端 Proxy 架構（建議）：
#   Browser → EduMath Backend (Node/Python...) → Video API
#   Secret Key 只存在後端，前端只知道後端 Proxy URL
# ================================================================

# ---- Provider 設定 ----
# 'mock'   = 使用 Demo 資料（預設，尚未取得正式 API 前使用）
# 'remote' = 使用正式 API
VIDEO_API_PROVIDER=mock

# ---- 正式 API 設定（取得 API 文件後填入） ----
# 正式 API 的 Base URL（不含 trailing slash）
# 例：VIDEO_API_BASE_URL=https://api.example.com/v1
VIDEO_API_BASE_URL=

# API Key（僅開發環境；正式環境走後端 Proxy，此欄留空）
# 例：VIDEO_API_KEY=your_api_key_here
VIDEO_API_KEY=

# 逾時毫秒（預設 8000）
VIDEO_API_TIMEOUT=8000

# Cache TTL 毫秒（預設 300000 = 5 分鐘）
VIDEO_API_CACHE_TTL=300000

# ---- 均一教育平台（待確認 API 資訊） ----
# 目前均一教育平台公開 API 資訊尚未確認
# 請參閱：https://www.junyiacademy.org
# 或聯繫均一取得合作 API 資訊
# JUNYI_API_BASE_URL=
# JUNYI_API_KEY=
# JUNYI_EMBED_ALLOWED=false
